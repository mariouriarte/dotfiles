#!/usr/bin/env bash

STATE="${XDG_RUNTIME_DIR:-/tmp}/panel-status-$UID.state"

# ─── CPU usage ───────────────────────────────────────────────
read -r _ user nice system idle iowait irq softirq steal _ </proc/stat

cpu_idle=$((idle + iowait))
cpu_total=$((user + nice + system + idle + iowait + irq + softirq + steal))

# ─── Network ─────────────────────────────────────────────────
iface=$(ip route show default 2>/dev/null | awk 'NR==1 {print $5}')

if [[ -n "$iface" && -r "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
    rx=$(<"/sys/class/net/$iface/statistics/rx_bytes")
else
    rx=0
fi

now_ms=$(date +%s%3N)

prev_total=$cpu_total
prev_idle=$cpu_idle
prev_rx=$rx
prev_ms=$now_ms
prev_iface=$iface

if [[ -r "$STATE" ]]; then
    read -r prev_total prev_idle prev_rx prev_ms prev_iface <"$STATE"
fi

# ─── CPU % ───────────────────────────────────────────────────
dt=$((cpu_total - prev_total))
di=$((cpu_idle - prev_idle))

if ((dt > 0)); then
    cpu_pct=$(awk -v dt="$dt" -v di="$di" \
        'BEGIN { printf "%.0f", 100*(dt-di)/dt }')
else
    cpu_pct=0
fi

# ─── Download rate ───────────────────────────────────────────
elapsed=$((now_ms - prev_ms))

if [[ "$iface" == "$prev_iface" && $elapsed -gt 0 && $rx -ge $prev_rx ]]; then
    net_bps=$(((rx - prev_rx) * 1000 / elapsed))
else
    net_bps=0
fi

printf '%s %s %s %s %s\n' \
    "$cpu_total" "$cpu_idle" "$rx" "$now_ms" "$iface" >"$STATE"

# Red siempre en MB/s
net=$(awk -v b="$net_bps" \
    'BEGIN { printf "%.2f", b / 1000000 }')

# ─── RAM ─────────────────────────────────────────────────────
mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
mem_available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)

ram_pct=$(awk -v total="$mem_total" -v avail="$mem_available" \
    'BEGIN { printf "%.0f", 100*(total-avail)/total }')

# ─── Top 3 aplicaciones por RAM ──────────────────────────────
#
# Agrupa todos los procesos con el mismo nombre.
# Ejemplo: todos los procesos "brave" se suman.
#
# Se muestra una de las tres cada 5 segundos.

APP_NAME_MAX=12

mapfile -t top_mem_apps < <(
    ps -eo comm=,rss= |
        awk '
            {
                mem[$1] += $2
            }
            END {
                for (app in mem)
                    print app, mem[app]
            }
        ' |
        sort -k2,2nr |
        head -n 3
)

if ((${#top_mem_apps[@]} > 0)); then
    app_index=$((($(date +%s) / 5) % ${#top_mem_apps[@]}))

    read -r app_name app_kb <<<"${top_mem_apps[$app_index]}"

    # Limitar longitud del nombre
    if ((${#app_name} > APP_NAME_MAX)); then
        app_name="${app_name:0:$((APP_NAME_MAX - 1))}…"
    fi

    # Convertir RAM
    if ((app_kb >= 1048576)); then
        app_mem=$(awk -v kb="$app_kb" \
            'BEGIN { printf "%.1fGB", kb/1048576 }')
    else
        app_mem=$(awk -v kb="$app_kb" \
            'BEGIN { printf "%.0fMB", kb/1024 }')
    fi
else
    app_name="-"
    app_mem="0MB"
fi

# ─── Find hwmon devices ──────────────────────────────────────
cpu_hwmon=""
psu_hwmon=""

for h in /sys/class/hwmon/hwmon*; do
    [[ -r "$h/name" ]] || continue

    name=$(<"$h/name")

    case "$name" in
    k10temp)
        cpu_hwmon="$h"
        ;;
    corsairpsu*)
        psu_hwmon="$h"
        ;;
    esac
done

# ─── CPU temperature ─────────────────────────────────────────
if [[ -n "$cpu_hwmon" && -r "$cpu_hwmon/temp1_input" ]]; then
    cpu_temp=$(awk -v t="$(cat "$cpu_hwmon/temp1_input")" \
        'BEGIN { printf "%.0f", t/1000 }')
else
    cpu_temp="?"
fi

# ─── NVIDIA GPU ──────────────────────────────────────────────
gpu_data=$(nvidia-smi \
    --query-gpu=utilization.gpu,temperature.gpu \
    --format=csv,noheader,nounits 2>/dev/null | head -n1)

if [[ -n "$gpu_data" ]]; then
    IFS=',' read -r gpu_pct gpu_temp <<<"$gpu_data"

    gpu_pct=${gpu_pct// /}
    gpu_temp=${gpu_temp// /}
else
    gpu_pct="?"
    gpu_temp="?"
fi

# ─── Corsair PSU ─────────────────────────────────────────────
if [[ -n "$psu_hwmon" ]]; then
    psu_v=$(awk -v x="$(cat "$psu_hwmon/in1_input")" \
        'BEGIN { printf "%.2f", x/1000 }')

    psu_w=$(awk -v x="$(cat "$psu_hwmon/power1_input")" \
        'BEGIN { printf "%.0f", x/1000000 }')

    psu_temp=$(awk -v x="$(cat "$psu_hwmon/temp1_input")" \
        'BEGIN { printf "%.0f", x/1000 }')
else
    psu_v="?"
    psu_w="?"
    psu_temp="?"
fi

# ─── Fixed-width fields ──────────────────────────────────────
#
# U+2800 = Braille Blank.
# Visualmente está vacío, pero Plasma/Qt lo conserva como
# carácter real y evita que se colapsen los espacios.

PAD=$'\u2800'

# Relleno a la izquierda
pad() {
    local width="$1"
    local value="$2"
    local len=${#value}
    local n=$((width - len))
    local out=""

    ((n < 0)) && n=0

    for ((i = 0; i < n; i++)); do
        out+="$PAD"
    done

    printf '%s%s' "$out" "$value"
}

# Relleno a la derecha
rpad() {
    local width="$1"
    local value="$2"
    local len=${#value}
    local n=$((width - len))
    local out="$value"

    ((n < 0)) && n=0

    for ((i = 0; i < n; i++)); do
        out+="$PAD"
    done

    printf '%s' "$out"
}

# ─── Campos formateados ──────────────────────────────────────

# Aplicación
app_name_f=$(rpad "$APP_NAME_MAX" "$app_name")
app_mem_f=$(pad 6 "$app_mem")

# Red
net_f=$(pad 5 "$net")

# RAM
ram_f=$(rpad 4 "${ram_pct}%")

# CPU
cpu_f=$(rpad 4 "${cpu_pct}%")
cpu_t_f=$(rpad 5 "${cpu_temp}°C")

# GPU
gpu_f=$(rpad 4 "${gpu_pct}%")
gpu_t_f=$(rpad 5 "${gpu_temp}°C")

# PSU
psu_v_f="$psu_v"
psu_w_f=$(rpad 5 "${psu_w}W")
psu_t_f=$(rpad 5 "${psu_temp}°C")

# ─── Colores ─────────────────────────────────────────────────
PURPLE=$'\e[38;5;141m' # App RAM
BLUE=$'\e[38;5;12m'    # LAN
CYAN=$'\e[38;5;27m'    # RAM
ORANGE=$'\e[38;5;202m' # CPU
GREEN=$'\e[38;5;154m'  # GPU
PINK=$'\e[38;5;198m'   # PSU
RESET=$'\e[0m'

# ─── Etiquetas / iconos ──────────────────────────────────────
NET_ICON='LAN'
RAM_ICON='RAM'
CPU_ICON='CPU'
GPU_ICON='GPU'
PSU_ICON=''

# ─── Output ──────────────────────────────────────────────────
printf '%b┃%b %s %s  %b┃%b %s %s MB/s  %b┃%b %s %s  %b┃%b %s %s %s  %b┃%b %s %s %s  %b┃%b %s %sV %s %s\n' \
    "$PURPLE" "$RESET" "$app_name_f" "$app_mem_f" \
    "$BLUE" "$RESET" "$NET_ICON" "$net_f" \
    "$CYAN" "$RESET" "$RAM_ICON" "$ram_f" \
    "$ORANGE" "$RESET" "$CPU_ICON" "$cpu_f" "$cpu_t_f" \
    "$GREEN" "$RESET" "$GPU_ICON" "$gpu_f" "$gpu_t_f" \
    "$PINK" "$RESET" "$PSU_ICON" "$psu_v_f" "$psu_w_f" "$psu_t_f"
